{
  "$comment": "Starting point only. Deliberately conservative: permissions default to prompting, and the only hooks wired are the two the cross-thread work register needs to function at all. Read README.md before widening either. Merge into your own ~/.claude/settings.json \u2014 do not blindly overwrite it.",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(rm -rf /)",
      "Bash(sudo rm *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(.next/**)",
      "Read(coverage/**)",
      "Read(*.lock)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME\"/.claude/hooks/thread-register-identity.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME\"/.claude/hooks/thread-register-gate.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME\"/.claude/hooks/thread-register-gate.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME\"/.claude/hooks/thread-register-signoff.py; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
