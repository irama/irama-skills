{
  "$comment": "Starting point only. Deliberately conservative: permissions default to prompting, and no hooks are wired. Read README.md before widening either. Merge into your own ~/.claude/settings.json — do not blindly overwrite it.",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(rm -rf /)",
      "Bash(sudo rm *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(.next/**)",
      "Read(coverage/**)",
      "Read(*.lock)"
    ]
  }
}
