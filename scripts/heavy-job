#!/usr/bin/env python3
"""heavy-job: machine-wide slots for heavy jobs (full test suites, production builds).

  heavy-job run -- <cmd...>          hold a slot while <cmd> runs; exit with its code
  heavy-job acquire --for-pid <pid>  hold a slot until <pid> exits; prints export lines
                                     (use: eval "$(heavy-job acquire --for-pid $$)")
  heavy-job waits [--since DATE]     wait-time report (the counter-metric)
  heavy-job record --repo <git-common-dir> --tree <tree-sha> --gate <gate-id> [--vitest-json <file>]
                                     log a passed gate run (and keep a copy of its vitest json)
  heavy-job passed --repo <git-common-dir> --tree <tree-sha> --gate <gate-id>
                                     exit 0 if this tree already passed this gate, 1 if not

Ledger (record / passed):
  Key is (realpath of --repo, --tree, --gate). Entries live 7 days. passed matches an exact
  entry, or one of the 20 most recent entries for (repo, gate) whose tree differs from --tree
  only in inert paths (git diff --no-renames --name-only; a git error, such as a GC'd tree, is
  no match). On a match, stdout is:
    matched <recorded-tree> exact
    matched <recorded-tree> differs only in <path>, <path>, ...
  then, if record stored a vitest json for <recorded-tree>:
    vitest-json <absolute path to the stored copy>
  Exit codes: 0 match, 1 no match, 64 bad arguments (tree not a hex sha), 1 on record if the
  --vitest-json file cannot be read (nothing is recorded then).
  HEAVY_JOB_INERT: space-separated globs (* = within one path segment, ** = any depth,
  leading ! excludes). Default: *.md docs/**/*.md docs/**/*.html !docs/agent-surface.md .scratch/**

Settings (env overrides the file): HEAVY_SLOTS (default 2), HEAVY_WORKERS (default 4),
HEAVY_MAX_WAIT_S (default 1800; past it, proceed unslotted with a stderr warning).
Settings file: $HEAVY_JOB_CONFIG, default ~/.config/heavy-job.env (KEY=VALUE lines).
State dir: $HEAVY_JOB_STATE_DIR, default ~/.local/state/heavy-job (slots/, waits.ndjson,
passed.ndjson, vitest/<repo-hash>-<tree>.json).
Nested calls (HEAVY_JOB_HELD=1 already set) never wait.
"""
import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import shlex
import statistics
import subprocess
import sys
import time

DEFAULTS = {"HEAVY_SLOTS": "2", "HEAVY_WORKERS": "4", "HEAVY_MAX_WAIT_S": "1800",
            # Never a .ts/.tsx/.js/.json: nav type-checks docs/design-bundle/*.ts(x), and
            # report.mjs reads docs/agent-surface.md for its verdict.
            "HEAVY_JOB_INERT": "*.md docs/**/*.md docs/**/*.html !docs/agent-surface.md .scratch/**"}
LEDGER_TTL_S = 7 * 86400
LEDGER_SCAN = 20
SHA_RE = re.compile(r"[0-9a-f]{40}([0-9a-f]{24})?")
REPORT_EVERY_S = 10
POLL_S = 0.5
_WARNED_BAD_INT = set()


def state_dir():
    return os.environ.get("HEAVY_JOB_STATE_DIR") or os.path.expanduser("~/.local/state/heavy-job")


def setting(key):
    """Env wins, then the settings file, then the default. Values are never logged."""
    if os.environ.get(key):
        return os.environ[key]
    path = os.environ.get("HEAVY_JOB_CONFIG") or os.path.expanduser("~/.config/heavy-job.env")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:]
                k, sep, v = line.partition("=")
                if sep and k.strip() == key:
                    return v.strip().strip("'\"")
    except OSError:
        pass
    return DEFAULTS.get(key)


def setting_int(key):
    """setting(key) as an int. An unparseable value warns once and falls back to the default."""
    raw = setting(key)
    try:
        return int(raw)
    except (TypeError, ValueError):
        if key not in _WARNED_BAD_INT:
            _WARNED_BAD_INT.add(key)
            say(f"{key}={raw!r} is not a number, using default {DEFAULTS[key]}")
        return int(DEFAULTS[key])


def say(msg):
    print(f"heavy-job: {msg}", file=sys.stderr, flush=True)


def child_env():
    env = dict(os.environ, HEAVY_JOB_HELD="1")
    env.setdefault("VITEST_MAX_WORKERS", str(setting_int("HEAVY_WORKERS")))
    return env


def _lsof_holder(path):
    """Best-effort: which pid still has `path` open. Never raises, never fatal."""
    try:
        out = subprocess.run(["lsof", "-t", path], capture_output=True, text=True, timeout=2).stdout
        pids = [p for p in out.split() if p.strip()]
        return pids[0] if pids else None
    except Exception:
        return None


def holder_text(slots_dir, i):
    path = os.path.join(slots_dir, f"slot-{i}")
    try:
        with open(path) as f:
            h = json.load(f)
        text = f"slot {i}: pid {h['pid']} in {h['cwd']} running `{h['cmd']}`, held {time.time() - h['t']:.0f}s"
        try:
            os.kill(h["pid"], 0)
        except ProcessLookupError:
            holder_pid = _lsof_holder(path)
            text += f" (pid {h['pid']} is dead; fd still held by pid {holder_pid})" if holder_pid else f" (pid {h['pid']} is dead; fd holder unknown)"
        except (PermissionError, TypeError, KeyError):
            pass
        return text
    except (OSError, ValueError, KeyError):
        return f"slot {i}: holder unknown"


def acquire():
    """Block until a slot is free, or HEAVY_MAX_WAIT_S passes.

    Returns (fd, slot, wait_s) on a slot, or (None, None, wait_s) if the wait timed out
    and the caller must proceed unslotted.
    """
    slots_dir = os.path.join(state_dir(), "slots")
    os.makedirs(slots_dir, exist_ok=True)
    n = max(1, setting_int("HEAVY_SLOTS"))
    max_wait = max(1, setting_int("HEAVY_MAX_WAIT_S"))
    t0 = time.time()
    last_report = None
    while True:
        for i in range(n):
            fd = os.open(os.path.join(slots_dir, f"slot-{i}"), os.O_RDWR | os.O_CREAT, 0o644)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                continue
            wait = time.time() - t0
            if last_report is not None:
                say(f"got slot {i} after waiting {wait:.0f}s")
            return fd, i, wait
        wait = time.time() - t0
        if wait >= max_wait:
            say(f"timed out after {wait:.0f}s waiting for a slot (HEAVY_MAX_WAIT_S={max_wait}s); "
                f"proceeding unslotted. Unblock: free a slot (heavy-job waits) or raise HEAVY_MAX_WAIT_S.")
            return None, None, wait
        if last_report is None or time.time() - last_report >= REPORT_EVERY_S:
            say(f"waiting {wait:.0f}s for one of {n} slots (times out at {max_wait}s); "
                + "; ".join(holder_text(slots_dir, i) for i in range(n)))
            last_report = time.time()
        time.sleep(POLL_S)


def claim(fd, slot, wait, pid, cmd_text, t_start):
    """Write holder info into the locked slot file and append the wait line."""
    os.ftruncate(fd, 0)
    os.pwrite(fd, json.dumps({"pid": pid, "cwd": os.getcwd(), "cmd": cmd_text[:200], "t": time.time()}).encode(), 0)
    line = {"start": t_start, "wait_s": round(wait, 1), "slot": slot, "cwd": os.getcwd(), "cmd": cmd_text[:200]}
    with open(os.path.join(state_dir(), "waits.ndjson"), "a") as f:
        f.write(json.dumps(line) + "\n")


def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd_run(cmd):
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        say("usage: heavy-job run -- <cmd...>")
        return 64
    if os.environ.get("HEAVY_JOB_HELD") == "1":
        os.execvpe(cmd[0], cmd, child_env())
    text, start = shlex.join(cmd), now_iso()
    fd, slot, wait = acquire()
    pass_fds = ()
    if fd is not None:
        claim(fd, slot, wait, os.getpid(), text, start)
        pass_fds = (fd,)
    # The child inherits the lock fd, so an orphaned child tree keeps the slot until it exits.
    try:
        rc = subprocess.run(cmd, env=child_env(), pass_fds=pass_fds).returncode
    except KeyboardInterrupt:
        rc = 130
    except FileNotFoundError:
        say(f"command not found: {cmd[0]}")
        rc = 127
    return 128 - rc if rc < 0 else rc


def exports():
    env = child_env()
    return "".join(f"export {k}={shlex.quote(env[k])}\n" for k in ("VITEST_MAX_WORKERS", "HEAVY_JOB_HELD"))


def cmd_acquire(pid):
    if os.environ.get("HEAVY_JOB_HELD") == "1":
        sys.stdout.write(exports())
        return 0
    text = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    start = now_iso()
    fd, slot, wait = acquire()
    if fd is None:
        # Timed out waiting for a slot; proceed unslotted, nothing to release later.
        sys.stdout.write(exports())
        return 0
    claim(fd, slot, wait, pid, text, start)
    ready_r, ready_w = os.pipe()
    if os.fork() == 0:
        # Holder. Detach from the caller's pipe BEFORE the parent prints, or `eval "$(...)"`
        # never sees EOF and the calling gate deadlocks on its own holder.
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        for std in (0, 1, 2):
            os.dup2(null, std)
        os.close(ready_r)
        os.write(ready_w, b"1")
        os.close(ready_w)
        # ponytail: pid liveness by kill(0) every 0.5 s; a reused pid keeps the slot until it exits too.
        while True:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                os._exit(0)
            except PermissionError:
                pass
            time.sleep(POLL_S)
    os.close(ready_w)
    ready = os.read(ready_r, 1)
    os.close(ready_r)
    os.close(fd)
    if not ready:
        say("holder died before signalling ready")
        return 1
    sys.stdout.write(exports())
    return 0


def cmd_waits(since):
    path = os.path.join(state_dir(), "waits.ndjson")
    cutoff = dt.datetime.fromisoformat(since).astimezone() if since else None
    rows = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    r = json.loads(line)
                    if cutoff is None or dt.datetime.fromisoformat(r["start"]) >= cutoff:
                        rows.append(r)
                except (ValueError, KeyError):
                    continue
    except OSError:
        pass
    if not rows:
        print(f"count 0{' since ' + since if since else ''}")
        return 0
    w = [r["wait_s"] for r in rows]
    print(f"count {len(rows)}  median {statistics.median(w):.1f}s  longest {max(w):.1f}s" + (f"  (since {since})" if since else ""))
    print("longest 5:")
    for r in sorted(rows, key=lambda r: r["wait_s"], reverse=True)[:5]:
        print(f"  {r['wait_s']:.1f}s  {r['start']}  {r['cwd']}  {r['cmd'][:80]}")
    return 0


def glob_re(pattern):
    """Path glob to regex: ** spans directories, * and ? stay inside one segment."""
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pattern[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif pattern[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(pattern[i]), i + 1
    return re.compile(out + r"\Z")


def is_inert(path, patterns):
    keep = [glob_re(p) for p in patterns if not p.startswith("!")]
    drop = [glob_re(p[1:]) for p in patterns if p.startswith("!")]
    return any(r.match(path) for r in keep) and not any(r.match(path) for r in drop)


def vitest_store(repo, tree):
    return os.path.join(state_dir(), "vitest", f"{hashlib.sha256(repo.encode()).hexdigest()[:12]}-{tree}.json")


def ledger_args(args):
    if not SHA_RE.fullmatch(args.tree):
        say(f"--tree must be a hex tree sha, got {args.tree!r}")
        return None
    return os.path.realpath(args.repo)


def cmd_record(args):
    repo = ledger_args(args)
    if repo is None:
        return 64
    vdir = os.path.join(state_dir(), "vitest")
    os.makedirs(vdir, exist_ok=True)
    cutoff = time.time() - LEDGER_TTL_S
    for name in os.listdir(vdir):
        path = os.path.join(vdir, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            pass
    if args.vitest_json:
        try:
            shutil.copyfile(args.vitest_json, vitest_store(repo, args.tree))
        except OSError as e:
            say(f"cannot store --vitest-json ({e}); nothing recorded")
            return 1
    # ponytail: append-only, never compacted; a line is ~200 bytes, prune when it matters.
    with open(os.path.join(state_dir(), "passed.ndjson"), "a") as f:
        f.write(json.dumps({"t": time.time(), "repo": repo, "tree": args.tree, "gate": args.gate}) + "\n")
    return 0


def recent_passes(repo, gate):
    """Trees that passed (repo, gate) in the last 7 days, newest first, deduped."""
    cutoff, trees = time.time() - LEDGER_TTL_S, []
    try:
        with open(os.path.join(state_dir(), "passed.ndjson")) as f:
            for line in f:
                try:
                    r = json.loads(line)
                    if r["repo"] == repo and r["gate"] == gate and r["t"] >= cutoff:
                        trees.append(r["tree"])
                except (ValueError, KeyError, TypeError):
                    continue
    except OSError:
        pass
    return list(dict.fromkeys(reversed(trees)))


def matched(repo, tree, line):
    print(line)
    store = vitest_store(repo, line.split()[1])
    if os.path.isfile(store):
        print(f"vitest-json {store}")
    return 0


def cmd_passed(args):
    repo = ledger_args(args)
    if repo is None:
        return 64
    trees = recent_passes(repo, args.gate)
    if args.tree in trees:
        return matched(repo, args.tree, f"matched {args.tree} exact")
    patterns = setting("HEAVY_JOB_INERT").split()
    for old in trees[:LEDGER_SCAN]:
        # --no-renames: a rename from src/ into docs/ must list the deleted code path too.
        r = subprocess.run(["git", "--git-dir", repo, "diff", "--no-renames", "--name-only", "-z", old, args.tree],
                           capture_output=True, text=True)
        if r.returncode != 0:
            continue  # recorded tree garbage-collected (or repo gone): no match, never a crash
        paths = [p for p in r.stdout.split("\0") if p]
        if all(is_inert(p, patterns) for p in paths):
            return matched(repo, old, f"matched {old} differs only in {', '.join(paths)}")
    return 1


def main():
    p = argparse.ArgumentParser(prog="heavy-job", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="sub", required=True)
    r = sub.add_parser("run")
    r.add_argument("cmd", nargs=argparse.REMAINDER)
    a = sub.add_parser("acquire")
    a.add_argument("--for-pid", type=int, required=True)
    w = sub.add_parser("waits")
    w.add_argument("--since", help="YYYY-MM-DD (local time)")
    for name in ("record", "passed"):
        q = sub.add_parser(name)
        q.add_argument("--repo", required=True, help="git common dir (git rev-parse --path-format=absolute --git-common-dir)")
        q.add_argument("--tree", required=True, help="tree sha (git rev-parse HEAD^{tree})")
        q.add_argument("--gate", required=True, help="gate-id string, e.g. 'ci-gate v9 <12 hex>'")
        if name == "record":
            q.add_argument("--vitest-json", help="vitest json of this run, stored for later skips")
    args = p.parse_args()
    if args.sub == "run":
        return cmd_run(args.cmd)
    if args.sub == "acquire":
        return cmd_acquire(args.for_pid)
    if args.sub == "record":
        return cmd_record(args)
    if args.sub == "passed":
        return cmd_passed(args)
    return cmd_waits(args.since)


if __name__ == "__main__":
    sys.exit(main())
